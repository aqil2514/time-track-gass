# Database
POSTGRES_USER=timetrack
POSTGRES_PASSWORD=timetrack123
POSTGRES_DB=timetrack

# Ports
BACKEND_PORT=8080
WEB_PORT=3000

# Security
JWT_SECRET=your-secret-key-change-in-production

# Z.AI API
ZAI_API_KEY=your-zai-api-key
ZAI_BASE_URL=https://open.bigmodel.cn/api/coding/paas/v4/
ZAI_VISION_MODEL_PRIMARY=glm-4.6v
ZAI_VISION_MODEL_FALLBACK=glm-4-flash
ZAI_TEXT_MODEL_FAST=glm-4.7-flashx
ZAI_TEXT_MODEL_SMART=glm-4.7
ZAI_MAX_INLINE_RETRIES=2
ZAI_MAX_QUEUE_RETRIES=5

# Workers
RETRY_QUEUE_WORKERS=3
RETRY_QUEUE_INTERVAL=10s

# Features
ENABLE_SESSIONS=true
ENABLE_DAILY_SUMMARY=true

# CORS
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173,http://localhost:1420

# Gin Mode (debug or release)
GIN_MODE=release

# Frontend API URL (untuk build frontend)
VITE_API_URL=http://localhost:8080