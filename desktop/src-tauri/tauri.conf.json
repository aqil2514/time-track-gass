{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "time-track",
  "version": "0.2.1",
  "identifier": "com.gasstech.timetrack",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "Time Track",
        "width": 800,
        "height": 600
      }
    ],
    "security": {
      "csp": null
    }
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDRERUEwNTMwMzU2RUNCQTkKUldTcHkyNDFNQVhxVGNxTHVvVUJTOFEyazdHK1l4alZXTGRROXdyOHEwdFVFeExTWUtjTjN6eVQK",
      "endpoints": [
        "https://raw.githubusercontent.com/username/timetrack/main/update.json"
      ]
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}